# Copy this file to ".env" and fill in your own values.
# Never commit the real ".env" file to git.

# MongoDB connection string.
# Local MongoDB:      mongodb://127.0.0.1:27017/admin_panel
# MongoDB Atlas:       mongodb+srv://user:password@cluster.mongodb.net/admin_panel
MONGODB_URI=mongodb://127.0.0.1:27017/admin_panel

# Secret used to sign login tokens (JWT). Make this a long random string.
JWT_SECRET=change_this_to_a_long_random_secret

# How long a login stays valid for.
JWT_EXPIRES_IN=8h

# Port the server runs on.
PORT=4000

# The very first admin account, auto-created on first startup
# if no admin exists yet in the database.
BOOTSTRAP_ADMIN_NAME=Super Admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
